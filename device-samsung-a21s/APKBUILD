# Reference: <https://postmarketos.org/devicepkg>
maintainer="Thomas Turner <tturner@lineageos.org>"
pkgname=device-samsung-a21s
pkgver=1
pkgrel=19
pkgdesc="Samsung Galaxy A21s"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-avbtool
	android-tools-mkbootimg
	busybox-extras
	firmware-samsung-a21s
	linux-samsung-a21s
	openssh-server-pam
	postmarketos-base
	python3
"
makedepends="
	devicepkg-dev
	gcc
	musl-dev
"
source="
	deviceinfo
	setup-usb-network.sh
	s2mu106-switch.py
	s2mu106_working_state.json
	usb-network.service
	s2mu106-battery-manager.py
	s2mu106-battery-manager.service
	screen-off.sh
	screen-on.sh
	screen-off.service
	a21s-display.py
	10-unmanage-usb.conf
	10-console.conf
	99-wifi.conf
	wlan0-init.service
	00-allow-root.conf
	telnetd.service
	80-wifi.rules
	10-compat.conf
	compat.c
	init
	watchdog-petter.py
	watchdog-petter.service
	a21s-console-dashboard.py
	a21s-console-dashboard.service
"
subpackages="$pkgname-systemd"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
	gcc -O2 -fPIC -shared -Wall "$srcdir/compat.c" -o "$srcdir/libsystemd-compat-4.19.so" -ldl
}

package() {
	devicepkg_package $startdir $pkgname

	# Systemd 262 compatibility interceptor library and preload
	install -Dm755 "$srcdir/libsystemd-compat-4.19.so" "$pkgdir/usr/lib/libsystemd-compat-4.19.so"
	install -d "$pkgdir/etc"
	echo "/usr/lib/libsystemd-compat-4.19.so" > "$pkgdir/etc/ld.so.preload"

	# Systemd 262 compatibility drop-ins (disable problematic sandboxing)
	install -d "$pkgdir/etc/systemd/system/service.d"
	install -Dm644 "$srcdir/10-compat.conf" "$pkgdir/etc/systemd/system/service.d/10-compat.conf"
	install -d "$pkgdir/etc/systemd/system.conf.d"
	cat << "EOF" > "$pkgdir/etc/systemd/system.conf.d/10-compat.conf"
[Manager]
DefaultEnvironment="LD_PRELOAD=/usr/lib/libsystemd-compat-4.19.so"
EOF

	# Early init wrapper and hardware watchdog petter daemon
	install -Dm755 "$srcdir/init" "$pkgdir/usr/bin/init"
	install -Dm755 "$srcdir/watchdog-petter.py" "$pkgdir/usr/bin/watchdog-petter.py"
	install -Dm644 "$srcdir/watchdog-petter.service" "$pkgdir/usr/lib/systemd/system/watchdog-petter.service"
	install -d "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
	ln -s ../watchdog-petter.service "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/watchdog-petter.service"

	# Fallback telnetd rescue service
	install -Dm644 "$srcdir/telnetd.service" "$pkgdir/usr/lib/systemd/system/telnetd.service"

	# USB network setup & PMIC switch
	install -Dm755 "$srcdir/setup-usb-network.sh" "$pkgdir/usr/bin/setup-usb-network.sh"
	install -Dm755 "$srcdir/s2mu106-switch.py" "$pkgdir/usr/bin/s2mu106-switch.py"
	install -Dm644 "$srcdir/s2mu106_working_state.json" "$pkgdir/etc/s2mu106_working_state.json"
	install -Dm644 "$srcdir/usb-network.service" "$pkgdir/usr/lib/systemd/system/usb-network.service"

	# S2MU106 battery management daemon
	install -Dm755 "$srcdir/s2mu106-battery-manager.py" "$pkgdir/usr/bin/s2mu106-battery-manager.py"
	install -d "$pkgdir/usr/bin"
	ln -s s2mu106-battery-manager.py "$pkgdir/usr/bin/battery-status"
	install -Dm644 "$srcdir/s2mu106-battery-manager.service" "$pkgdir/usr/lib/systemd/system/s2mu106-battery-manager.service"

	# Multi-user enabled services
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../usb-network.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/usb-network.service"
	ln -s ../s2mu106-battery-manager.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/s2mu106-battery-manager.service"

	# Wi-Fi configuration, udev rule, and auto-init service
	install -Dm644 "$srcdir/99-wifi.conf" "$pkgdir/etc/NetworkManager/conf.d/99-wifi.conf"
	install -Dm644 "$srcdir/80-wifi.rules" "$pkgdir/etc/udev/rules.d/80-wifi.rules"
	install -Dm644 "$srcdir/wlan0-init.service" "$pkgdir/usr/lib/systemd/system/wlan0-init.service"
	ln -s ../wlan0-init.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/wlan0-init.service"

	# Install Wi-Fi firmware files if present
	if [ -d "$startdir/wifi" ]; then
		install -d "$pkgdir/vendor/etc/wifi"
		cp -a "$startdir/wifi/"* "$pkgdir/vendor/etc/wifi/"
	fi

	# Screen-off power saver (installed, disabled by default on boot)
	install -Dm755 "$srcdir/a21s-display.py" "$pkgdir/usr/bin/a21s-display"
	install -Dm755 "$srcdir/screen-off.sh" "$pkgdir/usr/bin/screen-off"
	install -Dm755 "$srcdir/screen-on.sh" "$pkgdir/usr/bin/screen-on"
	install -Dm644 "$srcdir/screen-off.service" "$pkgdir/usr/lib/systemd/system/screen-off.service"

	# Console framebuffer system status dashboard (active by default)
	install -Dm755 "$srcdir/a21s-console-dashboard.py" "$pkgdir/usr/bin/a21s-console-dashboard.py"
	install -Dm644 "$srcdir/a21s-console-dashboard.service" "$pkgdir/usr/lib/systemd/system/a21s-console-dashboard.service"
	ln -s ../a21s-console-dashboard.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/a21s-console-dashboard.service"

	# NetworkManager ignore USB gadget
	install -Dm644 "$srcdir/10-unmanage-usb.conf" "$pkgdir/etc/NetworkManager/conf.d/10-unmanage-usb.conf"

	# Systemd console logging
	install -Dm644 "$srcdir/10-console.conf" "$pkgdir/etc/systemd/system.conf.d/10-console.conf"

	# SSH root config
	install -Dm644 "$srcdir/00-allow-root.conf" "$pkgdir/etc/ssh/sshd_config.d/00-allow-root.conf"

	# Mask plymouth services to prevent boot crashes
	install -d "$pkgdir/etc/systemd/system"
	for u in plymouth-start.service plymouth-quit.service plymouth-quit-wait.service \
	         plymouth-halt.service plymouth-reboot.service plymouth-poweroff.service \
	         plymouth-kexec.service plymouth-read-write.service plymouth-switch-root.service; do
		ln -sf /dev/null "$pkgdir/etc/systemd/system/$u"
	done
}

