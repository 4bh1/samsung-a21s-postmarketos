# Reference: <https://postmarketos.org/devicepkg>
maintainer="Thomas Turner <tturner@lineageos.org>"
pkgname=device-samsung-a21s
pkgver=1
pkgrel=9
pkgdesc="Samsung Galaxy A21s"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-avbtool
	android-tools-mkbootimg
	firmware-samsung-a21s
	linux-postmarketos-exynos850
	postmarketos-base
	python3
"
makedepends="
	android-tools-mkdtboimg
	devicepkg-dev
	dtc
"
source="
	deviceinfo
	exynos850-samsung-a21s-empty.dts
	setup-usb-network.sh
	s2mu106-switch.py
	s2mu106_working_state.json
	usb-network.service
	s2mu106-battery-manager.py
	s2mu106-battery-manager.service
	screen-off.sh
	screen-on.sh
	screen-off.service
	10-unmanage-usb.conf
	10-console.conf
"
subpackages="$pkgname-systemd"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname

	dtc -O dtb -o "$srcdir/dtbo" -I dts "$srcdir/exynos850-samsung-a21s-empty.dts"
	mkdtboimg create "$srcdir/dtbo.img" "$srcdir/dtbo" --custom0=0x6 --custom1=0x20
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
	install -Dm755 "$srcdir/setup-usb-network.sh" "$pkgdir/usr/bin/setup-usb-network.sh"
	install -Dm755 "$srcdir/s2mu106-switch.py" "$pkgdir/usr/bin/s2mu106-switch.py"
	install -Dm644 "$srcdir/s2mu106_working_state.json" "$pkgdir/etc/s2mu106_working_state.json"
	install -Dm644 "$srcdir/usb-network.service" "$pkgdir/usr/lib/systemd/system/usb-network.service"
	install -Dm755 "$srcdir/s2mu106-battery-manager.py" "$pkgdir/usr/bin/s2mu106-battery-manager.py"
	install -d "$pkgdir/usr/bin"
	ln -s s2mu106-battery-manager.py "$pkgdir/usr/bin/battery-status"
	install -Dm644 "$srcdir/s2mu106-battery-manager.service" "$pkgdir/usr/lib/systemd/system/s2mu106-battery-manager.service"
	install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../usb-network.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/usb-network.service"
	ln -s ../s2mu106-battery-manager.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/s2mu106-battery-manager.service"

	# Screen-off power saver
	install -Dm755 "$srcdir/screen-off.sh" "$pkgdir/usr/bin/screen-off"
	install -Dm755 "$srcdir/screen-on.sh" "$pkgdir/usr/bin/screen-on"
	install -Dm644 "$srcdir/screen-off.service" "$pkgdir/usr/lib/systemd/system/screen-off.service"
	ln -s ../screen-off.service "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/screen-off.service"

	# NetworkManager ignore USB gadget
	install -Dm644 "$srcdir/10-unmanage-usb.conf" "$pkgdir/etc/NetworkManager/conf.d/10-unmanage-usb.conf"

	# Systemd console logging
	install -Dm644 "$srcdir/10-console.conf" "$pkgdir/etc/systemd/system.conf.d/10-console.conf"

	# Mask plymouth services to prevent boot crashes
	install -d "$pkgdir/etc/systemd/system"
	for u in plymouth-start.service plymouth-quit.service plymouth-quit-wait.service \
	         plymouth-halt.service plymouth-reboot.service plymouth-poweroff.service \
	         plymouth-kexec.service plymouth-read-write.service plymouth-switch-root.service; do
		ln -sf /dev/null "$pkgdir/etc/systemd/system/$u"
	done
}

