# Kernel config based on: arch/arm64/configs/exynos850-a21snsxx_defconfig
maintainer="Thomas Turner <tturner@lineageos.org>"
pkgname=linux-samsung-a21s
pkgver=4.19.325
pkgrel=2
pkgdesc="Samsung Galaxy A21s downstream kernel fork (with native SCSC Wi-Fi)"
arch="aarch64"
_carch="arm64"
_flavor="samsung-a21s"
url="https://github.com/samsungexynos850/android_kernel_samsung_exynos850"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	android-tools-mkdtboimg
	bash
	bc
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
"

_repository="android_kernel_samsung_exynos850"
_commit="b8c71b7aecece9c67f0e840a6b074573e8041d20"
_config="config-$_flavor.$arch"

# Source
source="
	$pkgname-$_commit.tar.gz::https://github.com/samsungexynos850/$_repository/archive/$_commit.tar.gz
	$_config
	a21s.cfg
	0001-remove-werror.patch
	0002-decon-fbops-dummy-ops.patch
	0003-sec-hard-reset-disable-bug.patch
"
builddir="$srcdir/$_repository-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KCFLAGS="-Wno-error -Wno-sizeof-pointer-memaccess" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot/dtbs

	# Base DTBs (packaged with custom1=0xff for Samsung bootloader)
	for dtb_name in exynos3830 exynos850-a217f-3gb exynos850-a217f-4gb exynos850-a217f-6gb; do
		mkdtboimg create "$pkgdir"/boot/dtbs/"${dtb_name}".dtb arch/arm64/boot/dts/exynos/exynos3830.dtb --custom1=0xff
	done

	# DTBO image
	mkdtboimg cfg_create "$pkgdir"/boot/dtbo.img "$srcdir"/a21s.cfg -d arch/arm64/boot/dts/samsung/a21s

	make install modules_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

