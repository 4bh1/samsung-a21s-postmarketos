3a8a4fe4a6136aef54ec959db6b7bc717fb07067c96c64b7bacf58bfccc1bf18b50fa21283549b201ba0464e02285f186d723717af16ba84293dec4446eb3a3e  config-postmarketos-exynos850.aarch64
3a5980a5ca582906aa265b08e33a7c1cebf3f10fcd5a74db7557e04d63cc8dd509803ffe16be8ba7fdb58dccc3bf1112ab137fa00a90c227271760eb04d40606  0001-dwc3-force-gadget-softconnect.patch
